#!/usr/bin/env bash
set -euo pipefail

# Runs bpx-rag with the CUDA and cuDNN runtime libraries on the library path.
# Machine-specific locations belong in scripts/bpx-rag-cuda.env, which is untracked.
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_dir="$(cd "$script_dir/.." && pwd)"

if [[ -f "$script_dir/bpx-rag-cuda.env" ]]; then
    # shellcheck source=/dev/null
    source "$script_dir/bpx-rag-cuda.env"
fi

runtime_dir="${BPX_RAG_CUDA_RUNTIME_DIR:?set BPX_RAG_CUDA_RUNTIME_DIR to the CUDA runtime directory}"
binary="${BPX_RAG_BINARY:-$repo_dir/target/release/bpx-rag}"
binary_dir="$(dirname "$binary")"
cuda_lib_dir="$runtime_dir/nvidia/cu13/lib"
cudnn_lib_dir="$runtime_dir/nvidia/cudnn/lib"

if [[ ! -x "$binary" ]]; then
    printf 'bpx-rag binary is missing or not executable: %s\n' "$binary" >&2
    exit 1
fi

for lib_dir in "$cuda_lib_dir" "$cudnn_lib_dir"; do
    if [[ ! -d "$lib_dir" ]]; then
        printf 'CUDA runtime directory is missing: %s\n' "$lib_dir" >&2
        exit 1
    fi
done

export LD_LIBRARY_PATH="$binary_dir:$cuda_lib_dir:$cudnn_lib_dir${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

exec "$binary" "$@"
