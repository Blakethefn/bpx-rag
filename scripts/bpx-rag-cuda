#!/usr/bin/env bash
set -euo pipefail

runtime_dir="${BPX_RAG_CUDA_RUNTIME_DIR:-/media/blakethefn/2000HDD1/dev/project-assets/bpcontext/cuda-runtime}"
binary="${BPX_RAG_BINARY:-/media/blakethefn/2000HDD1/dev/cargo-targets/bpcontext/release/bpx-rag}"
binary_dir="$(dirname "$binary")"
cuda_lib_dir="$runtime_dir/nvidia/cu13/lib"
cudnn_lib_dir="$runtime_dir/nvidia/cudnn/lib"

if [[ ! -x "$binary" ]]; then
    printf 'bpx-rag binary is missing or not executable: %s\n' "$binary" >&2
    exit 1
fi

for lib_dir in "$cuda_lib_dir" "$cudnn_lib_dir"; do
    if [[ ! -d "$lib_dir" ]]; then
        printf 'CUDA runtime directory is missing: %s\n' "$lib_dir" >&2
        exit 1
    fi
done

export ORT_CACHE_DIR="${ORT_CACHE_DIR:-/media/blakethefn/2000HDD1/dev/project-assets/bpcontext/ort-cache}"
export LD_LIBRARY_PATH="$binary_dir:$cuda_lib_dir:$cudnn_lib_dir${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

exec "$binary" "$@"
